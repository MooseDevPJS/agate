{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blocco",
  "version": "0.1.2",
  "identifier": "app.blocco.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Blocco",
        "width": 1180,
        "height": 740,
        "minWidth": 900,
        "minHeight": 580,
        "backgroundColor": "#141311",
        "decorations": false,
        "shadow": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blocco: http://blocco.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Blocco",
    "shortDescription": "Launcher leggero per Minecraft",
    "longDescription": "Blocco: profili, mod, texture pack, shader, OptiFine e mantelli personalizzati per Minecraft Java.",
    "category": "Game",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCQUYwQjVFQTMxNTk1MEYKUldRUGxSV2pYZ3V2NndRV082R3piR1poVmoyLzFmcHFaZEdPb0hyUko4STY2N05DVlF5WWhrR3UK",
      "endpoints": [
        "https://github.com/MooseDevPJS/blocco/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}